    <item>
      <title>AI for Science：从AlphaFold到自主实验室，重塑人类科学发现的边界</title>
      <link>http://192.168.50.247:1313/insights/ai-for-sciencealphafold-20251203174004904-1/</link>
      <pubDate>Wed, 03 Dec 2025 17:40:04 +0800</pubDate>
