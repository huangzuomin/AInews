    <item>
      <title>Bret Taylor：一位穿越AI风暴中心的硅谷“构建者”</title>
      <link>http://192.168.50.247:1313/insights/bret-taylorai-20250803094006235-0/</link>
      <pubDate>Sun, 03 Aug 2025 09:40:06 +0800</pubDate>
