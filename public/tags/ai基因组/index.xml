    <item>
      <title>AI书写生命代码：从ΦX174到基因组「App Store」，开启生物学新纪元</title>
      <link>http://192.168.50.247:1313/insights/aix174app-store-20250918194006784-0/</link>
      <pubDate>Thu, 18 Sep 2025 19:40:06 +0800</pubDate>
