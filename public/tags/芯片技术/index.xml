    <item>
      <title>Arm SME2：移动AI的“幕后”革命，重塑端侧智能新版图</title>
      <link>http://192.168.50.247:1313/insights/arm-sme2ai-20250714161004770-0/</link>
      <pubDate>Mon, 14 Jul 2025 16:10:04 +0800</pubDate>
