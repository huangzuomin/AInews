    <item>
      <title>骨感现实：中国“具身智能”领跑者奔向资本集市</title>
      <link>http://192.168.50.247:1313/insights/article-20260409174006135-1/</link>
      <pubDate>Thu, 09 Apr 2026 17:40:06 +0800</pubDate>
