    <item>
      <title>AI淘金热中的镐与铲：Meta重估数据标注，揭示智能基石新价值</title>
      <link>http://192.168.50.247:1313/insights/aimeta-20250902164004943-2/</link>
      <pubDate>Tue, 02 Sep 2025 16:40:04 +0800</pubDate>
