    <item>
      <title>AI&#39;s Unfading Glow：全球医疗健康资本寒冬中的一道暖流</title>
      <link>http://192.168.50.247:1313/insights/ais-unfading-glow-20250716121004533-0/</link>
      <pubDate>Wed, 16 Jul 2025 12:10:04 +0800</pubDate>
