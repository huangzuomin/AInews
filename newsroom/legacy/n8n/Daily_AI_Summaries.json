    },
    {
      "parameters": {
        "jsCode": "/**\n * 聚合所有批次的评估结果并选出得分最高的5篇文章\n * 确保最终选择的文章质量最高\n */\nfunction aggregateAndRankArticles() {\n  const allBatchResults = $input.all();\n  const allEvaluatedArticles = [];\n  \n  // 收集所有批次的评估结果\n  allBatchResults.forEach(batchResult => {\n    let jsonText = batchResult.json.text.trim();\n    // 移除代码围栏\n    if (jsonText.startsWith('```')) {\n      jsonText = jsonText.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n    }\n    \n    try {\n      const batchData = JSON.parse(jsonText);\n      if (batchData.evaluated_articles && Array.isArray(batchData.evaluated_articles)) {\n        allEvaluatedArticles.push(...batchData.evaluated_articles);\n      }\n    } catch (error) {\n      console.error('解析批次结果失败:', error);\n    }\n  });\n  \n  // 按评分降序排序\n  allEvaluatedArticles.sort((a, b) => b.score - a.score);\n  \n  // 选择得分最高的5篇文章\n  const top5Articles = allEvaluatedArticles.slice(0, 5);\n  \n  // 获取原始文章数据\n  const originalArticles = $('Get Today\\'s AI Articles').all();\n  \n  // 为所有文章准备更新数据\n  const articleUpdates = originalArticles.map(article => {\n    const evaluated = allEvaluatedArticles.find(e => e.id === article.json.id);\n    const isSelected = top5Articles.some(t => t.id === article.json.id);\n    \n    return {\n      id: article.json.id,\n      ai_score: evaluated ? evaluated.score : 0,\n      selection_reason: evaluated ? evaluated.reason : '未被评估',\n      evaluated_at: new Date().toISOString(),\n      is_selected: isSelected\n    };\n  });\n  \n  // 获取选中文章的完整信息\n  const selectedArticlesWithDetails = top5Articles.map(selected => {\n    const fullArticle = originalArticles.find(article => \n      article.json.id === selected.id\n    );\n    \n    return {\n      ...fullArticle.json,\n      evaluation_score: selected.score,\n      selection_reason: selected.reason\n    };\n  });\n  \n  return {\n    selectedArticles: selectedArticlesWithDetails,\n    articleUpdates: articleUpdates,\n    evaluationSummary: {\n      total_articles: originalArticles.length,\n      evaluated_articles: allEvaluatedArticles.length,\n      selected_articles: top5Articles.length,\n      average_score: allEvaluatedArticles.reduce((sum, a) => sum + a.score, 0) / allEvaluatedArticles.length\n    }\n  };\n}\n\nreturn aggregateAndRankArticles();"
      },
      "id": "b588503f-1547-4160-8457-1712c57e16a6",
      "name": "Aggregate and Rank",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        696,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "/**\n * 处理选中的文章数据，准备用于后续的摘要生成\n */\nfunction processSelectedArticles() {\n  const aggregatedData = $json;\n  \n  return {\n    detailedArticles: aggregatedData.selectedArticles,\n    dailySummary: {\n      selected_article_ids: aggregatedData.selectedArticles.map(a => a.id),\n      evaluation_summary: aggregatedData.evaluationSummary\n    },\n    articleUpdates: aggregatedData.articleUpdates\n  };\n}\n\nreturn processSelectedArticles();"
      },
      "id": "d0b76367-52cb-4949-9899-2bf863c7a85e",
      "name": "Process Selected Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
