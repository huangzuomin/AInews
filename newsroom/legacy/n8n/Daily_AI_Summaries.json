      "id": "1a7cf92e-b903-48e6-8bc4-91426351628d",
      "name": "Evaluate Article Batch 5",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        320,
        1700
