    {
      "parameters": {
        "jsCode": "// 设置今天和明天的日期范围\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst tomorrow = new Date(today);\ntomorrow.setDate(tomorrow.getDate() + 1);\n\nreturn {\n  todayStart: today.toISOString(),\n  tomorrowStart: tomorrow.toISOString(),\n  todayFormatted: today.toLocaleDateString('zh-CN')\n};"
      },
      "id": "106b6518-00b1-443e-8f16-05d14b047d95",
      "name": "Set Dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -780,
        900
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "ai_articles",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "=created_at",
              "condition": "gte",
              "keyValue": "={{ $items('Set Dates')[0].json.todayStart }}"
            },
            {
              "keyName": "created_at",
              "condition": "lt",
              "keyValue": "={{ $items('Set Dates')[0].json.tomorrowStart }}"
            }
          ]
        }
      },
