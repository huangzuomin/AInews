    {
      "parameters": {
        "jsCode": "/**\n * 计算文章的最终AI评分\n * @param {Object} llmResponse - 来自Basic LLM Chain的Gemini评分结果\n * @param {Object} originalArticle - 来自拆分文章列表的原始文章数据\n * @returns {Object} - 包含计算出的ai_score的文章对象\n */\nconst llmResponse = $input.item(0).json;\nconst originalArticle = $('拆分文章列表').item.json;\n\n// 解析Gemini返回的评分JSON\nlet scores;\ntry {\n  // Gemini API返回格式为 {text: '...'}\n  const responseText = llmResponse.text || llmResponse.response || '';\n  // 尝试提取JSON部分\n  const jsonMatch = responseText.match(/\\{[\\s\\S]*?\\}/);\n  if (jsonMatch) {\n    scores = JSON.parse(jsonMatch[0]);\n  } else {\n    throw new Error('No JSON found in Gemini response');\n  }\n} catch (error) {\n  // 如果解析失败，使用默认分数\n  scores = {\n    novelty_score: 5.0,\n    impact_score: 5.0,\n    clarity_score: 5.0,\n    depth_score: 5.0\n  };\n}\n\n// 计算加权分数\nconst weighted_score = \n  (scores.novelty_score * 0.3) +\n  (scores.impact_score * 0.4) +\n  (scores.clarity_score * 0.1) +\n  (scores.depth_score * 0.2);\n\n// 计算最终得分并四舍五入到小数点后两位\nconst ai_score = Math.round(weighted_score * 100) / 100;\n\n// 返回包含所有原始数据和计算出的ai_score的对象\nreturn {\n  id: originalArticle.id,\n  content: originalArticle.content,\n  created_at: originalArticle.created_at,\n  ai_score: ai_score,\n  novelty_score: scores.novelty_score,\n  impact_score: scores.impact_score,\n  clarity_score: scores.clarity_score,\n  depth_score: scores.depth_score\n};"
      },
      "id": "816ba67b-99ca-4685-abb3-1820bec00e58",
      "name": "计算最终评分",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        -360
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "ai_articles",
        "filterType": "manual",
        "matchingColumns": [
          "id"
        ],
        "additionalFields": {
          "ai_score": "={{ $json.ai_score }}",
          "novelty_score": "={{ $json.novelty_score }}",
          "impact_score": "={{ $json.impact_score }}",
          "clarity_score": "={{ $json.clarity_score }}",
          "depth_score": "={{ $json.depth_score }}"
        }
      },
      "id": "a9a88842-dfc7-4aa1-9ac7-59784c03ccb6",
      "name": "更新评分到数据库",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        160,
        -340
      ],
