    {
      "parameters": {},
      "id": "2423fffe-4c16-4cc6-90ea-0fc6da04439b",
      "name": "合并评分结果",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        220,
        -580
      ]
    },
    {
      "parameters": {
        "jsCode": "/**\n * 筛选Top 5文章并标记is_selected字段\n * @param {Array} items - 所有已评分的文章数组\n * @returns {Array} - 按ai_score降序排列的前5篇文章\n */\nconst items = $input.all();\nconst articles = items.map(item => item.json);\n\n// 按ai_score降序排序\narticles.sort((a, b) => b.ai_score - a.ai_score);\n\n// 选取前5篇文章\nconst top5Articles = articles.slice(0, 5);\n\n// 为每篇文章添加is_selected标记\nconst articlesWithSelection = articles.map(article => ({\n  ...article,\n  is_selected: top5Articles.some(top => top.id === article.id)\n}));\n\n// 返回包含top5文章的对象\nreturn {\n  top_articles: top5Articles,\n  all_articles_with_selection: articlesWithSelection,\n  total_articles: articles.length,\n  selection_date: new Date().toISOString()\n};"
      },
      "id": "372c9e4b-84f6-48b1-843a-37ef9e985f10",
      "name": "筛选Top5文章",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -320
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {},
        "jsCode": "/**\n * 处理筛选Top5文章节点返回的数据\n * @param {Object} selectionData - 来自筛选Top5文章节点的数据\n * @returns {Array} - 包含is_selected标记的所有文章数组\n */\nconst selectionData = $input.item(0).json;\nreturn selectionData.all_articles_with_selection;"
      },
      "id": "f6207857-c8dc-40ac-8437-a0852fd1048c",
