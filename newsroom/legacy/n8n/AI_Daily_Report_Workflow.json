    {
      "parameters": {
        "jsCode": "/**\n * 格式化日报数据\n * @param {Object} summaryData - 来自Gemini的综述文章\n * @param {Object} selectionData - 来自筛选节点的数据\n * @returns {Object} - 格式化后的日报数据\n */\nconst summaryResponse = $input.first().json;\nconst selectionData = $input.last().json;\n\n// 提取Gemini返回的文本内容\nconst reportContent = summaryResponse.text || summaryResponse.content || '';\n\n// 构建完整的日报数据\nconst dailyReport = {\n  id: `daily_report_${new Date().toISOString().split('T')[0]}`,\n  title: `AI内参日报 - ${new Date().toLocaleDateString('zh-CN')}`,\n  content: reportContent,\n  summary: `今日精选${selectionData.top_articles.length}篇AI领域重要文章`,\n  created_at: new Date().toISOString(),\n  article_count: selectionData.total_articles,\n  selected_articles: selectionData.top_articles.map(article => ({\n    id: article.id,\n    content: article.content,\n    ai_score: article.ai_score\n  })),\n  generation_metadata: {\n    model_used: 'gemini-1.5-pro',\n    selection_date: selectionData.selection_date,\n    total_processed: selectionData.total_articles\n  }\n};\n\nreturn dailyReport;"
      },
      "id": "fc405c05-373c-44b1-8c17-eedb15b9c338",
      "name": "格式化日报数据",
      "type": "n8n-nodes-base.code",
