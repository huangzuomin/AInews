    {
      "parameters": {
        "jsCode": "/**\n * 生成同步操作的详细日志\n * 记录成功和失败的详细信息\n */\nfunction generateSyncLog() {\n  const updateResult = $json;\n  const originalPost = $('Format Steemit Content').first().json;\n  \n  const logEntry = {\n    timestamp: new Date().toISOString(),\n    operation: 'steemit_sync_realtime',\n    summary_id: updateResult.id || originalPost.summaryId,\n    status: updateResult.steemit_posted ? 'success' : 'failed',\n    steemit_url: updateResult.steemit_url,\n    transaction_id: updateResult.steemit_transaction_id,\n    block_num: updateResult.steemit_block_num,\n    error: updateResult.steemit_error,\n    retry_count: updateResult.retry_count || 0,\n    post_title: originalPost.title,\n    post_date: originalPost.originalDate,\n    trigger_type: 'database_insert'\n  };\n\n  return logEntry;\n}\n\nreturn generateSyncLog();"
      },
      "id": "generate-sync-log-id",
      "name": "Generate Sync Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        0
      ]
    },
