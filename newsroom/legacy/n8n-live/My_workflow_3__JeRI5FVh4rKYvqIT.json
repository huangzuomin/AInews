      "typeVersion": 1
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"message\"][\"text\"]}}",
              "operation": "startsWith",
              "value2": "/summary"
            }
          ]
        }
      },
      "id": "354da11e-bc95-4bee-9ace-458f3757d942",
