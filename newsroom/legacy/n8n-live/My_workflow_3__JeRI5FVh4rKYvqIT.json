              "key": "text",
              "cssSelector": "body",
              "skipSelectors": "svg, a"
            }
          ]
        },
        "options": {}
      },
      "id": "e9a8b3cb-75b5-4960-81d2-26a72c5a78a6",
      "name": "Text Extractor",
      "type": "n8n-nodes-base.html",
      "position": [
