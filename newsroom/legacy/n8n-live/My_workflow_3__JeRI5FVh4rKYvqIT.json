{
  "id": "JeRI5FVh4rKYvqIT",
  "name": "My workflow 3",
  "active": 0,
  "nodes": [
    {
      "parameters": {
        "content": "Quick-Start Telegram Echo Bot\n\nA single-node Telegram bot that parses /help, /summary <URL>, or /img <prompt> and returns either a help menu, a 10–12-point article summary, or an “image in progress” acknowledgement.",
        "width": 400,
        "color": 7
      },
      "id": "66de54b2-cdd8-48d9-811a-a9e64b740288",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -1460,
        -120
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Listener\n\nWatches for any new message from Telegram and kicks the flow off.",
        "color": 7
      },
      "id": "833e2c97-c67f-4cbc-848c-4cec9a9abfdd",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -1320,
        240
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Command Router\n\nChecks if the message starts with /help, /summary, or /img, and sends it down the right path.",
        "color": 7
      },
      "id": "630de562-cd70-4e97-a9b4-b972d787ea52",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -960,
        600
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Help Responder\n\nWhen it sees /help, replies with a simple list of commands and how to use them.",
        "color": 7
      },
      "id": "10c8705d-fc4b-4f2b-9263-b2843c8bf8af",
      "name": "Sticky Note3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -440,
        -160
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Summary Checker\n\nSees if the text begins with /summary. If yes, it moves on to fetch the article; if no, skips onward.",
        "color": 7
      },
      "id": "95ddadcc-6954-4461-b424-02c9d1cea3d2",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -540,
        560
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Fetcher\n\nGoes to the provided URL and downloads the page’s HTML.\n",
        "color": 7
      },
      "id": "65c88800-3697-419b-9513-2286ca481171",
      "name": "Sticky Note5",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -140,
        40
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Image Prompt Checker\n\nSees if the text begins with /img. If yes, forwards the prompt to the image generator; if not, ends the flow.",
        "color": 7
      },
      "id": "d046fbfb-0ace-4564-9772-e6d885c38574",
      "name": "Sticky Note6",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -100,
        1000
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Text Extractor\n\nPulls out just the main article text (e.g. everything inside <body>).",
        "color": 7
      },
      "id": "c6b705e2-275e-429a-abda-d6d5d7764ace",
      "name": "Sticky Note7",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        220,
        260
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Image Generator\n\nSends your prompt to OpenAI’s image endpoint (or your chosen image API).",
        "color": 7
      },
      "id": "1aef695b-903a-4413-acb8-36097cacd66a",
      "name": "Sticky Note8",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        440,
        1180
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Summarizer\n\nSends the raw article text to OpenAI and asks for a 10–12-point professional bullet-point summary.",
        "color": 7
      },
      "id": "a3e7959b-37e9-4cac-a111-7d60c40b00cf",
      "name": "Sticky Note9",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        640,
        40
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Image Acknowledger\n\nTells the user “Got it—your image is being made!” (and later you can hook this up to send the actual picture URL).",
        "color": 7
      },
      "id": "a597e807-410e-40fa-9af2-97db6f53912d",
      "name": "Sticky Note10",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1060,
        840
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "Summary Sender\n\nDelivers the bullet-point summary back to the user in Telegram.\n",
        "color": 7
      },
      "id": "b42d75af-ef2a-4c0d-a9b1-0da728773f3e",
      "name": "Sticky Note11",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1260,
        40
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "8642a157-7401-4c6a-b0b9-6f47732ed2e3",
      "name": "Listener",
      "type": "n8n-nodes-base.telegramTrigger",
      "position": [
        -1020,
        280
      ],
      "webhookId": "61f2e55d-a41d-4594-a045-154264c78738",
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"message\"][\"text\"]}}",
              "operation": "startsWith",
              "value2": "/help"
            }
          ]
        }
      },
      "id": "182ffc86-6307-464b-9f20-bda0da500cfd",
      "name": "Command Router",
      "type": "n8n-nodes-base.if",
      "position": [
        -720,
        420
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "chatId": "={{$json[\"message\"][\"chat\"][\"id\"]}}",
        "text": "🤖 *Help Menu*\n\nUse `/summary <link>` to summarize an article.\nUse `/img <prompt>` to generate an image.\n\n_Example:_\n/summary https://example.com\n/img a futuristic cityscape",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "d0db1218-b65c-4ae6-8b68-23f599290e01",
      "name": "Help Responder",
      "type": "n8n-nodes-base.telegram",
      "position": [
