    {
      "parameters": {
        "jsCode": "// 获取上一个节点（HTTP Request）返回的HTML内容\nconst html = $input.item.json.data;\n\n// 使用正则表达式查找docHtmlCon变量的内容\n// 这个表达式会匹配 \"docHtmlCon\": \"...\" 直到下一个 \",\" 和 \"abstract\" 为止\nconst regex = /\"docHtmlCon\":\\s*\"(.*?)\"\\s*,\\s*\"abstract\"/s;\nconst match = html.match(regex);\n\n// 检查是否成功匹配\nif (match && match[1]) {\n  // 匹配到的内容在第二个捕获组 (match[1])\n  let content = match[1];\n\n  // JavaScript字符串中的 \\\" 需要转回 \"\n  content = content.replace(/\\\\\"/g, '\"');\n  \n  // 将提取到的干净的HTML内容作为新字段返回\n  $input.item.json.articleContent = content;\n\n} else {\n  // 如果没找到，返回一个错误提示\n  $input.item.json.error = \"无法在HTML中找到文章内容\";\n}\n\n// 返回处理后的数据项，以便下一个节点使用\nreturn $input.item;"
      },
