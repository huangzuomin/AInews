    {
      "parameters": {
        "jsCode": "const he = require('he');\n\n// 创建一个空数组，用于存放处理后的结果\nconst newItems = [];\n\n// 遍历 n8n 节点收到的每一个 item\nfor (const item of items) {\n    // 1. 创建一个当前 item 的深拷贝副本，这是一个非常安全的做法\n    const newItem = JSON.parse(JSON.stringify(item));\n\n    // 2. 在副本上进行解码操作\n    // 检查并解码 content 字段\n    if (newItem.json.content && typeof newItem.json.content === 'string') {\n        newItem.json.content = he.decode(newItem.json.content);\n    }\n\n    // 检查并解码 title 字段\n    if (newItem.json.title && typeof newItem.json.title === 'string') {\n        newItem.json.title = he.decode(newItem.json.title);\n    }\n    \n    // 3. 将处理完毕的副本推入新的结果数组\n    newItems.push(newItem);\n}\n\n// 4. 返回全新的、包含了解码后内容的结果数组\nreturn newItems;"
      },
